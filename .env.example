# Application Environment Configuration
PROJECT_NAME="Crisis Response Intelligence System (CRIS)"
VERSION="2.0.0"
APP_ENV=development

# Database connection string
# Local PostgreSQL with PostGIS (Primary):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/crisis_db
# Or Local SQLite fallback:
# DATABASE_URL=sqlite:///./crisis_response.db

# Security & JWT Authentication (Change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=replace-with-a-secure-random-256-bit-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Demo Seeder Password Override (used only when seeding initial demo accounts in development)
DEMO_SEED_PASSWORD=ChangeMeDemo123!

# Frontend Config
VITE_API_URL=/api
